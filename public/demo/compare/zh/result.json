e: 0.8em;\n    vertical-align: super;\n}\nspan.rev-format-change {\n    border-bottom: 2px dotted #ffa500;\n    cursor: help;\n}\ntd.rev-cell-ins {\n    background-color: #e6ffe6;\n}\ntd.rev-cell-del {\n    background-color: #ffe6e6;\n    text-decoration: line-through;\n}\ntd.rev-cell-merge {\n    background-color: #fff0e6;\n    border: 2px dashed #ff8c00;\n}\n</style></head><body><div data-section-index=\"0\" data-page-width=\"612.0\" data-page-height=\"792.0\" data-content-width=\"432.0\" data-content-height=\"648.0\" data-margin-top=\"72.0\" data-margin-right=\"90.0\" data-margin-bottom=\"72.0\" data-margin-left=\"90.0\" data-header-height=\"36.0\" data-footer-height=\"36.0\"><div class=\"docx-000000\"><p dir=\"ltr\" class=\"docx-Title\"><span class=\"docx-DefaultParagraphFont\">品牌设计服务协议</span></p></div><p dir=\"ltr\" class=\"docx-Normal\"><span class=\"docx-DefaultParagraphFont-000001\">甲方：星屿科技有限公司    乙方：青禾设计工作室</span></p><h1 dir=\"ltr\" class=\"docx-Heading1\"><span class=\"docx-DefaultParagraphFont-000002\">一、服务范围</span></h1><p dir=\"ltr\" class=\"docx-Normal\"><span class=\"docx-DefaultParagraphFont-000001\">乙方为甲方提供品牌视觉设计服务，包括标志设计、品牌色彩及基础应用规范。</span></p><p dir=\"ltr\" class=\"rev-para-ins docx-Normal\" data-author=\"Compare\" data-date=\"2000-01-01T00:00:00Z\"><ins class=\"rev-ins docx-000003\" data-author=\"Compare\" data-date=\"2000-01-01T00:00:00Z\"><span class=\"docx-DefaultParagraphFont-000004\">项目包含五轮方案调整，并提供最终源文件。</span></ins></p><p dir=\"ltr\" class=\"rev-para-del docx-Normal-000005\" data-author=\"Compare\" data-date=\"2000-01-01T00:00:00Z\"><del class=\"rev-del docx-000006\" data-author=\"Compare\" data-date=\"2000-01-01T00:00:00Z\"><span class=\"docx-DefaultParagraphFont-000007\">项目包含三轮方案调整。</span></del><span xml:space=\"preserve\" class=\"docx-000008\"> </span><span class=\"rev-para-mark-del\" title=\"Paragraph mark deleted\">¶</span></p><h1 dir=\"ltr\" class=\"docx-Heading1\"><span class=\"docx-DefaultParagraphFont-000002\">二、项目费用与付款</span></h1><p dir=\"ltr\" class=\"docx-Normal\"><span xml:space=\"preserve\" class=\"docx-DefaultParagraphFont-000001\">项目总费用为人民币 </span><ins class=\"rev-ins docx-000003\" data-author=\"Compare\" data-date=\"2000-01-01T00:00:00Z\"><span class=\"docx-DefaultParagraphFont-000009\">36,000</span></ins><del class=\"rev-del docx-000006\" data-author=\"Compare\" data-date=\"2000-01-01T00:00:00Z\"><span class=\"docx-DefaultParagraphFont-000010\">30,000</span></del><span xml:space=\"preserve\" class=\"docx-DefaultParagraphFont-000001\"> 元。</span></p><div align=\"left\"><table dir=\"ltr\" class=\"docx-000011\"><colgroup><col style=\"width: 216pt;\" /><col style=\"width: 216pt;\" /></colgroup><tr><td class=\"docx-000012\"><p dir=\"ltr\" class=\"docx-Normal-000013\"><span class=\"docx-DefaultParagraphFont-000014\">付款阶段</span></p></td><td class=\"docx-000012\"><p dir=\"ltr\" class=\"docx-Normal-000013\"><span class=\"docx-DefaultParagraphFont-000014\">付款比例</span></p></td></tr><tr><td class=\"docx-000015\"><p dir=\"ltr\" class=\"docx-Normal-000013\"><span class=\"docx-DefaultParagraphFont-000014\">合同签署后</span></p></td><td class=\"docx-000015\"><p dir=\"ltr\" class=\"docx-Normal-000016\"><span class=\"docx-DefaultParagraphFont-000017\">50%</span></p></td></tr><tr><td class=\"docx-000015\"><p dir=\"ltr\" class=\"docx-Normal-000013\"><span class=\"docx-DefaultParagraphFont-000014\">项目验收后</span></p></td><td class=\"docx-000015\"><p dir=\"ltr\" class=\"docx-Normal-000016\"><span class=\"docx-DefaultParagraphFont-000017\">50%</span></p></td></tr><tr class=\"rev-row-ins\" data-author=\"Compare\" data-date=\"2000-01-01T00:00:00Z\"><td class=\"docx-000018\"><p dir=\"ltr\" class=\"rev-para-ins docx-Normal-000013\" data-author=\"Compare\" data-date=\"2000-01-01T00:00:00Z\"><ins class=\"rev-ins\" data-author=\"Compare\" data-date=\"2000-01-01T00:00:00Z\"><span class=\"docx-DefaultParagraphFont-000014\">额外需求</span></ins></p></td><td class=\"docx-000018\"><p dir=\"ltr\" class=\"rev-para-ins docx-Normal-000013\" data-author=\"Compare\" data-date=\"2000-01-01T00:00:00Z\"><ins class=\"rev-ins\" data-author=\"Compare\" data-date=\"2000-01-01T00:00:00Z\"><span class=\"docx-DefaultParagraphFont-000014\">另行书面确认</span></ins></p></td></tr></table></div><h1 dir=\"ltr\" class=\"docx-Heading1\"><span class=\"docx-DefaultParagraphFont-000002\">三、交付与验收</span></h1><p dir=\"ltr\" class=\"docx-Normal-000019\"><span class=\"rev-format-change docx-000020\" title=\"Bold added, Font size changed, Font changed\" data-author=\"Compare\" data-date=\"2000-01-01T00:00:00Z\"><span class=\"docx-DefaultParagraphFont-000021\">乙方应于合同生效后 20 个工作日内交付全部成果。</span></span></p><h1 dir=\"ltr\" class=\"rev-para-ins docx-Heading1\" data-author=\"Compare\" data-date=\"2000-01-01T00:00:00Z\"><ins class=\"rev-ins docx-000003\" data-author=\"Compare\" data-date=\"2000-01-01T00:00:00Z\"><span class=\"docx-DefaultParagraphFont-000022\">四、知识产权</span></ins></h1><p dir=\"ltr\" class=\"docx-Normal\"><ins class=\"rev-ins docx-000003\" data-author=\"Compare\" data-date=\"2000-01-01T00:00:00Z\"><span class=\"docx-DefaultParagraphFont-000004\">甲方付清项目费用后，取得最终设计成果的约定使用权。</span></ins><del class=\"rev-del docx-000006\" data-author=\"Compare\" data-date=\"2000-01-01T00:00:00Z\"><span class=\"docx-DefaultParagraphFont-000007\">所有沟通通过电子邮件进行。</span></del></p></div></body></html>","revisions":[{"revisionType":"Inserted","text":"项目包含五轮方案调整，并提供最终源文件。\n","author":"Compare","date":"2000-01-01T00:00:00Z"},{"revisionType":"Deleted","text":"项目包含三轮方案调整。\n","author":"Compare","date":"2000-01-01T00:00:00Z"},{"revisionType":"Inserted","text":"36,000","author":"Compare","date":"2000-01-01T00:00:00Z"},{"revisionType":"Deleted","text":"30,000","author":"Compare","date":"2000-01-01T00:00:00Z"},{"revisionType":"Inserted","text":"额外需求\n另行书面确认\n","author":"Compare","date":"2000-01-01T00:00:00Z"},{"revisionType":"Inserted","text":"四、知识产权\n甲方付清项目费用后，取得最终设计成果的约定使用权。","author":"Compare","date":"2000-01-01T00:00:00Z"},{"revisionType":"Deleted","text":"